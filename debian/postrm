#!/bin/sh
set -e
case "$1" in
    remove|purge|upgrade)
        # A running instance would keep owning me.proton.vpn.kill_switch with
        # a deleted binary, blocking activation of the replacement. It may not
        # be running at all, hence || true.
        # -f because the name exceeds the 15 characters -x matches against.
        pkill -f "^/usr/libexec/proton-vpn-kill-switch-service" || true
        ;;
esac

#DEBHELPER#

exit 0
